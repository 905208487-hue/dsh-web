{
  "name": "@linxin666/dsh-recall",
  "description": "DSH web GUI plugin: recall the latest conversation turn (撤回，仅限最新一条).",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/core/rollback.d.ts",
      "default": "./lib/core/rollback.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "typescript": "~5.7.2",
    "tsdown": "0.22.2",
    "vitest": "^4.1.8",
    "vite-tsconfig-paths": "^6.1.1",
    "@types/node": "^22.20.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "license": "BSD-3-Clause"
}