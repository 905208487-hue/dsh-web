{
  "name": "dsh-web",
  "version": "0.1.1",
  "private": true,
  "description": "DeepSeek Harness Web GUI \u63d2\u4ef6\u5168\u5bb6\u6876\u3002\u76ae\u80a4\u3001\u5ba0\u7269\u4e0e\u793e\u533a\u63d2\u4ef6\u7d22\u5f15\u5df2\u62c6\u5206\u4e3a\u72ec\u7acb\u4ed3\u5e93\uff08dsh-skins / dsh-pet / dsh-community-plugins\uff09\uff0c\u672c\u4ed3\u901a\u8fc7 npm \u5305\u5185\u7f6e\u5b83\u4eec\u3002",
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-web-all/cordis.patch.yml"
    }
  },
  "files": [
    "package.json",
    "packages/dsh-web-all/cordis.patch.yml"
  ],
  "dependencies": {
    "@linxin666/dsh-web-all": "0.4.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:watch": "node scripts/dev-watch.mjs",
    "test": "pnpm -r test",
    "test:desktop": "node --test desktop/tests/*.test.mjs",
    "test:standards": "node scripts/test-standards.mjs --check",
    "test:standards:write": "node scripts/test-standards.mjs --write-baseline",
    "typecheck": "pnpm -r typecheck",
    "aggregate:check": "node scripts/aggregate.mjs --check",
    "runtime-deps:check": "node scripts/runtime-deps-check.mjs",
    "libs:check": "node scripts/lib-artifact-check.mjs",
    "libs:write": "node scripts/lib-artifact-check.mjs --write",
    "i18n:check": "node scripts/i18n-audit.mjs --check",
    "emoji:check": "node scripts/emoji-audit.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:mount": "bash scripts/e2e-mount.sh",
    "coverage:check": "node scripts/coverage-gate.mjs",
    "coverage:write": "node scripts/coverage-gate.mjs --write-baseline",
    "pr:review": "node scripts/pr-review.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "docs:list": "node scripts/verify-docs.mjs --list",
    "docs:write-pair": "node scripts/verify-docs.mjs --write",
    "sync-shared": "node scripts/sync-shared.mjs",
    "sync-shared:check": "node scripts/sync-shared.mjs --check",
    "market:build": "node scripts/market-build",
    "market:check": "node scripts/market-build --check",
    "market:fetch": "node scripts/market-fetch-inputs.mjs",
    "market:verify": "node scripts/market-verify-assets.mjs",
    "deploy:market": "node scripts/deploy-market"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-util-crypto": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-util-time": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-web-frontend": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.8",
    "lightningcss": "^1.32.0",
    "playwright": "^1.62.1",
    "semver": "^7.8.5",
    "tsdown": "^0.22.2",
    "@linxin666/dsh-client-ui-skin-center": "^0.4.2",
    "@linxin666/dsh-client-ui-community-plugins": "^0.4.2",
    "@linxin666/dsh-pet": "^0.4.2",
    "@linxin666/dsh-client-ui-preset-center": "^0.4.2"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0"
}
